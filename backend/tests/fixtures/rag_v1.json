          "vpn-check",
          "vpn-verify"
        ],
        "forbidden_evidence": [
          "vpn-archive"
        ],
        "answer_excludes": [
          "(?:立即|应当|直接|建议).{0,6}禁用证书校验"
        ],
        "facts": [
          {
            "id": "renew",
            "pattern": "证书.{0,8}(?:过期|到期).{0,12}续期",
