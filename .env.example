# ===== GLM (智谱) =====
ZHIPU_API_KEY=你的_API_KEY
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型链：按优先级排列，限流/不可用时自动切换下一个（故障转移）
GLM_MODELS=glm-4.7-flash,glm-4.6-flash,glm-4.5-flash,glm-4-flash
# 速度优先链（前端「速度」模式）：glm-4-flash 最快但能力最弱，放最前
GLM_MODELS_FAST=glm-4-flash,glm-4.7-flash,glm-4.5-flash
GLM_VISION_MODELS=glm-4v-flash

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=helpdesk
MYSQL_PASSWORD=你的密码
MYSQL_DB=it_helpdesk
