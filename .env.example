# ===== GLM (智谱) =====
ZHIPU_API_KEY=你的_API_KEY
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 项目默认的全部文本 LLM 统一使用 glm-5.3-flash；不静默切换到其他回答模型。
# 请求失败会由 Agent 安全链路转人工，而不是用另一种模型改变行为。
GLM_MODELS=glm-5.3-flash
# 为兼容旧客户端保留该字段；前端不再展示“速度 / 准确”模型切换。
GLM_MODELS_FAST=glm-5.3-flash
# intent / extract / judge 等结构化文本任务同样固定使用 glm-5.3-flash。
GLM_JSON_MODELS=glm-5.3-flash
GLM_VISION_MODELS=glm-4v-flash

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=helpdesk
MYSQL_PASSWORD=你的密码
MYSQL_DB=it_helpdesk
# 托管 MySQL 强制 TLS（TiDB Cloud Serverless 等云端部署）：true 时连接串
# 追加 ssl_verify_cert/ssl_verify_identity（本地 MySQL 保持 false/默认）
# MYSQL_SSL=false
# MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ===== RAG 知识库 =====
# ⚠️ 路径注意（踩过坑，见优化文档 #RAG-5）：
#   config.py 已用 BASE_DIR（项目根）推导【绝对路径】兜底，
#   默认即 项目根/docs/knowledge，任何目录启动都正确。
#   若用相对路径写这里，会按【启动时的 cwd】解析——从 backend/ 启动会错位！
#   所以这两个变量【默认注释掉】，让绝对路径兜底生效。
#   真要自定义，请写【绝对路径】：
# KB_ROOT=/path/to/your/docs/knowledge
# KB_VECTOR_DIR=/path/to/your/.rag/kb_chroma
KB_COLLECTION=kb_docs
# Git增量模式：Docker发布会导出固定提交快照；本机可直接读取KB_GIT_REPO。
# KB_SYNC_MODE=git
# KB_GIT_REPO=/path/to/repository
# KB_GIT_REF=HEAD
# KB_GIT_SUBDIR=docs/knowledge
# KB_GIT_EXPORT=/path/to/knowledge-source.json
# KB_PIPELINE_EPOCH=1
# 蓝绿双索引（Phase 5）：蓝=老库名（存量数据天然是蓝），绿=候选库。
# sync 永远写候选 → 切换改指针（.rag/kb_active.txt，秒级生效+重启保持）
KB_COLLECTION_BLUE=kb_docs
KB_COLLECTION_GREEN=kb_docs_candidate
# 嵌入模型：智谱 Embedding-3（付费 0.5 元/百万 tokens，需账号余额）

# ===== 混合检索（Phase 2）=====
# RRF 融合：score = Σ weight / (rrf_k + rank)
RRF_K=60
# 默认等权；通过固定 Gold Chunk 评测验证后才调整，不能只看单次问答效果。
RRF_VECTOR_WEIGHT=1.0
RRF_BM25_WEIGHT=1.0
RRF_RECALL_N=10
# RRF 融合后、来源上限前的候选数。0 保持历史行为（最终 Top-5 时为 10）。
# 只有固定 Gold Chunk 评测证明收益后才增大，例如 16；不会改变最终 Top-5 数量。
RRF_FUSION_CANDIDATE_N=0
# 同一来源在检索 Top-K 中最多保留几个子段；回答提示词会再按来源去重。
RAG_MAX_CHUNKS_PER_SOURCE=2
# 智谱 Rerank 二次精排。固定 60 条候选库评测曾从 R@1/3/5=0.750/0.883/0.917
# 退化为 0.217/0.550/0.700，当前语料中保持关闭；仅在新的隔离对照证明收益后开启。
RERANK_ENABLED=false
# 精排在来源限额前接收的原始子段数；保留实验配置，不能绕过固定保留集评测。
RERANK_CANDIDATE_N=16
RERANK_TOP_N=5

# ===== 安全（多租户/权限体系）=====
# Token 签名密钥：生产必须改为随机强密钥（openssl rand -hex 32）
SECRET_KEY=dev-secret-change-me-in-production

# ===== 用户自定义 LLM（OpenAI 兼容接口）=====
# 页面“模型设置”会把用户的 API Key 加密后写入数据库。先生成一条独立密钥：
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 复制输出到下面；不要使用项目示例值，也不要把真实值提交到 Git。
LLM_CONFIG_ENCRYPTION_KEY=
# 单次自定义模型调用超时（秒）。模型服务无响应时，Agent 会走已有安全兜底。
LLM_REQUEST_TIMEOUT=60
# 默认只接受 HTTPS 公网模型地址。单机调本地 Ollama/vLLM 时才改为 true。
LLM_ALLOW_PRIVATE_ENDPOINTS=false

# ===== 首次部署的演示账号 =====
# 首次建库时读取；服务器必须设置随机强密码，后续改动不会重置已创建的账号。
SEED_ADMIN_PASSWORD=请设置管理员强密码
SEED_ZHANGSAN_PASSWORD=请设置普通用户强密码
SEED_LISI_PASSWORD=请设置普通用户强密码

# ===== 监控 API 对接（P2：替代 mock）=====
# mock=读内存字典（离线零依赖）；real=HTTP 调用监控服务
MONITOR_MODE=mock
# 监控服务地址（real 模式）：本地 mock_monitor 服务默认 9100
MONITOR_BASE_URL=http://127.0.0.1:9100
# 认证 token（真实系统用，本地模拟服务留空）
MONITOR_API_TOKEN=
# HTTP 超时（秒）
MONITOR_TIMEOUT=5.0
# 失败重试次数（5xx/超时才重试）
MONITOR_MAX_RETRIES=2

# ===== 联合检索（多库，Phase 5）=====
# 逗号分隔的独立库名：对话问答跨库联合检索（在岗库自动包含）。
# 默认空 = 仅检索在岗库；示例：KB_EXTRA_COLLECTIONS=kb_docs_scale
KB_EXTRA_COLLECTIONS=

# ===== 单机过载保护 =====
# 同主机 worker 必须共享锁目录与预算；多主机部署需集中式准入。
AGENT_MAX_CONCURRENT=8
AGENT_MAX_INFLIGHT_HTTP=16
# AGENT_LOCK_DIR=/absolute/shared/path/agent_locks
# 数据库连接池应与在途请求预算协调；先用当前配置压测再提高上限。
DB_POOL_SIZE=16
DB_POOL_TIMEOUT=2
