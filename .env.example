# ===== GLM (智谱) =====
ZHIPU_API_KEY=你的_API_KEY
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型链：按优先级排列，限流/不可用时自动切换下一个（故障转移）
GLM_MODELS=glm-4.7-flash,glm-4.6-flash,glm-4.5-flash,glm-4-flash
# 速度优先链（前端「速度」模式）：glm-4-flash 最快但能力最弱，放最前
GLM_MODELS_FAST=glm-4-flash,glm-4.7-flash,glm-4.5-flash
GLM_VISION_MODELS=glm-4v-flash

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=helpdesk
MYSQL_PASSWORD=你的密码
MYSQL_DB=it_helpdesk

# ===== RAG 知识库 =====
# 源文档目录（唯一事实来源，sync 引擎扫描它）
KB_ROOT=docs/knowledge
# ChromaDB 持久化目录（本地文件）
KB_VECTOR_DIR=.rag/kb_chroma
KB_COLLECTION=kb_docs
# 嵌入模型：智谱 Embedding-3（付费 0.5 元/百万 tokens，需账号余额）

# ===== 混合检索（Phase 2）=====
# RRF 融合：score = Σ weight / (rrf_k + rank)
RRF_K=60
RRF_RECALL_N=10
# 智谱 Rerank 二次精排（付费模型，按需开启）
RERANK_ENABLED=false
RERANK_TOP_N=5
